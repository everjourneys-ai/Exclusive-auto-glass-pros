# Copy to .env.local for local development. Never commit real values.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# --- Lead storage (Supabase) — server-only ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server-side only — never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Instant lead alert by email (Resend) — server-only, optional ---
RESEND_API_KEY=
# Comma-separated list of inboxes that receive new-lead alerts
LEAD_ALERT_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Leads <leads@exclusiveautoglasspros.com>"
LEAD_ALERT_FROM=

# --- Conversion tracking — public, optional ---
# Google Tag Manager container ID (GTM-XXXXXXX). Leave empty to disable tracking.
NEXT_PUBLIC_GTM_ID=
